# Demo sunucusu şablonu — sunucuda:  cp .env.demo.example .env  ve değerleri doldur.
# docker-compose.demo.yml bu dosyayı (.env) okur.

# Sunucunun alan adı; A kaydı sunucu IP'sini göstermeli. Alan adı yoksa: <IP>.sslip.io
DOMAIN=""

# Yalnız harf ve rakam (bağlantı dizesine kaçışsız girer):  openssl rand -hex 24
# İlk kurulumdan sonra değiştirme: PostgreSQL parolayı yalnız boş volume'da alır.
POSTGRES_PASSWORD=""

# --- Marka (E-2) — sunucu tarafı; imaj yeniden derlenmeden `up -d` ile değişir ---
# Görünen ad; boşsa nötr "Medikal Satış Operasyon". Sekme başlığı "Siparişler · <ad>" olur.
APP_BRAND=""
# İsteğe bağlı logo: public/ altındaki yol (örn. /logo.png tam logo, /logo-mark.png dar işaret).
# Boşsa adın baş harfinden nötr bir işaret çizilir.
APP_LOGO=""
APP_LOGO_MARK=""

# --- Demo hesap parolaları (E-2) ---
# CANLI demo sunucusunda MUTLAKA doldur: boş bırakılırsa bilinen yerel varsayılanlar
# (admin123 / satici123 / operasyon123) kurulur. Seed ortamdan gelen parolayı yazdırmaz.
# Değişiklik yalnız seed'i yeniden çalıştırınca etkili olur (README "Demo ortamı" → Sıfırlama).
DEMO_ADMIN_PAROLA=""
DEMO_SATICI_PAROLA=""
DEMO_OPERASYON_PAROLA=""
