/test-results
/playwright-report
/blob-report
/playwright/.cache
/playwright/.auth

# yedekler
/backups

# PRD (dahili doküman, repoda tutulmuyor)
/PRD.md

# Screenshot script geçici veritabanı
/screenshots.db
/screenshots.db-*

# Sunum görselleri (script ile üretiliyor)
/sunum-gorseller

# Sunum görseli üretme script'i (dahili)
/scripts/screenshots.ts

# Dahili notlar / talimat dosyaları
/MD_files
