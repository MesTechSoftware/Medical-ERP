# Coolify DEMO dağıtımı şablonu — Application → Environment Variables sekmesine girilir.
# Bu dosya bir ŞABLONDUR: gerçek gizli değerleri buraya YAZMA.
#
# Build-time (derleme anı) değişken YOKTUR: projede NEXT_PUBLIC_* kullanılmaz; marka dahil her şey
# çalışma anında okunur. Aşağıdaki hepsini "Runtime" olarak gir; "Build Variable" kutusunu İŞARETLEME
# (özellikle DATABASE_URL ve parolalar derleme günlüğüne/katmanlara sızmasın).

# ======================= ZORUNLU (runtime) =======================

# Coolify'daki PostgreSQL 17 servisinin İÇ bağlantı URL'i (Postgres → "Postgres URL (internal)").
# Ana makine adı servisin UUID'sidir. Uygulama ve PostgreSQL aynı Coolify ağındaysa iç adres çalışır.
# Dışarı (public) port AÇMA.
DATABASE_URL="postgres://<kullanici>:<parola>@<postgres-servis-uuid>:5432/<veritabani>"

# Uygulama UTC çalışır (E-1 §(2)); Dockerfile zaten ayarlıyor, burada açıkça da girilebilir.
TZ="UTC"

# Demo hesap parolaları (E-2). CANLI demo sunucusunda MUTLAKA doldur: boşsa bilinen varsayılanlar
# (admin123 / satici123 / operasyon123) kurulur. Seed yalnız çalıştığında okur; değiştirirsen seed'i
# yeniden çalıştır.
DEMO_ADMIN_PAROLA=""
DEMO_SATICI_PAROLA=""
DEMO_OPERASYON_PAROLA=""

# ======================= İSTEĞE BAĞLI (runtime) =======================

# Marka (E-2): görünen ad; boşsa "Medikal Satış Operasyon". Değişince yeniden DEPLOY gerekmez,
# yalnız uygulamayı yeniden başlat.
APP_BRAND=""
# public/ altındaki yol (örn. /logo.png, /logo-mark.png). Boşsa baş harften nötr işaret çizilir.
APP_LOGO=""
APP_LOGO_MARK=""

# ======================= YALNIZ TERMİNALDEN SEED İÇİN =======================
# Bunları uygulamanın kalıcı değişkenlerine EKLEME; terminal komutunda satır başına ver
# (bkz. dağıtım adımları). Burada yalnız belge olarak durur.
#
#   NODE_ENV=development        -> seed-demo.ts / seed-gecmis.ts "production" korumasını tetiklemesin
#   DEMO_GECMIS=evet            -> yalnız 6 aylık geçmiş seed'i için
#   DEMO_GECMIS_HOST=<postgres-servis-uuid>  -> DATABASE_URL'deki ana makine adı (izin listesi)
